{
  "name": "xpm",
  "private": true,
  "version": "0.0.2-alpha",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n ui,api -c cyan,magenta \"vite\" \"npm run dev --workspace=server\"",
    "dev:ui": "vite",
    "dev:server": "npm run dev --workspace=server",
    "build": "tsc -b && vite build && npm run build --workspace=server",
    "build:ui": "tsc -b && vite build",
    "build:server": "npm run build --workspace=server",
    "lint": "eslint .",
    "preview": "vite preview",
    "run:built": "concurrently -n ui,api -c cyan,magenta \"vite preview\" \"npm run start --workspace=server\""
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-router": "^7.18.2",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
