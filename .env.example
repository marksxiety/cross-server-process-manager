# ── xpm-server (registry API) ────────────────────────────────────────────────
# HTTP port the registry API binds. Required — the server refuses to boot without it.
SERVER_PORT=5638

# ── SQL Server ───────────────────────────────────────────────────────────────
# Only "sqlsrv" is supported; the server refuses to boot otherwise.
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=backend
DB_USERNAME=root
DB_PASSWORD=
# TLS. Local/dev servers with self-signed certificates: encrypt off, trust on.
# Remote or Azure SQL: DB_ENCRYPT=true and DB_TRUST_SERVER_CERTIFICATE=false.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# Signs access tokens. Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access-token lifetime in seconds (default 43200 = 12 hours, max 604800).
JWT_EXPIRES_IN=43200
# Email verification and password reset link lifetime.
AUTH_LINK_TTL_MINUTES=30
# Optional override for the base URL used in verification/reset emails.
# When empty it is derived from VITE_SERVER_PROTOCOL, VITE_SERVER_HOST and VITE_WEB_PORT.
# AUTH_LINK_BASE_URL=

# ENV-managed admin account. Created or updated on server startup.
# The admin is created already verified; other users verify by email.
# The password is hashed before storage and never logged.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ── Mail (required for account access) ──────────────────────────────────────
# Used for account verification and password reset. Self-registered users
# cannot sign in until they open the verification link.
# For local development, leave MAIL_HOST empty to log the links to the console.
# Gmail:   smtp.gmail.com (587 STARTTLS) + App Password
# Outlook: smtp-mail.outlook.com (587 STARTTLS) + App Password
# M365:    smtp.office365.com (587 STARTTLS); SMTP AUTH must be enabled
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
# Defaults to MAIL_USER when empty. Must be allowed by the SMTP account.
MAIL_FROM=

# ── xpm-web (dashboard) ──────────────────────────────────────────────────────
# Only VITE_-prefixed vars reach the browser; they are baked in at build time.
# Port the dashboard is served on (Vite dev/preview and the PM2 serve process).
VITE_WEB_PORT=3000

# Where the browser reaches xpm-server — must match SERVER_PORT above.
VITE_SERVER_PROTOCOL=http
VITE_SERVER_HOST=localhost
VITE_SERVER_PORT=5638

# Bearer token the dashboard sends with every xpm-agent request.
# Must match AUTH_TOKEN in each agent's .env / .env.production.
# Leave empty only when agents run with ALLOW_INSECURE=true (local dev).
VITE_AGENT_AUTH_TOKEN=

# Add every dashboard origin to CORS_ORIGIN in the agent's .env
# (e.g. http://localhost:3000 for the dashboard).

# ── Prometheus (metrics graphs) ──────────────────────────────────────────────
# Browser-reachable Prometheus base URL. The Metrics tab queries
# /api/v1/query_range directly, so Prometheus must accept this dashboard's
# origin via --web.cors.origin. Leave empty to disable the charts.
VITE_PROMETHEUS_URL=http://localhost:9090

# ── Demo mode (README screenshots) ───────────────────────────────────────────
# Renders the dashboard from bundled fixtures (no backend or agents required).
# `npm run dev:demo -w web` loads .env.demo with this flag enabled.
VITE_USE_FIXTURES=false
