{
  "name": "xpm-server",
  "version": "1.1.0",
  "private": true,
  "description": "",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/src/index.js",
    "db:create": "tsx src/Console/Commands/CreateDatabaseCommand.ts",
    "db:migrate": "tsx src/Console/Commands/MigrateCommand.ts up",
    "db:migrate:rollback": "tsx src/Console/Commands/MigrateCommand.ts down",
    "db:migrate:baseline": "tsx src/Console/Commands/MigrateCommand.ts baseline",
    "db:seed": "tsx src/Console/Commands/SeedCommand.ts",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "migrate:create": "tsx src/Console/Commands/MakeMigrationCommand.ts",
    "migrate:up": "tsx src/Console/Commands/MigrateCommand.ts up",
    "migrate:down": "tsx src/Console/Commands/MigrateCommand.ts down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "mssql": "^12.7.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
