{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "db:create": "tsx src/scripts/createDatabase.ts",
    "db:setup": "npm run db:create && npm run migrate:up",
    "migrate:create": "node-pg-migrate --envPath .env -f .node-pg-migraterc.cjs create",
    "migrate:up": "node-pg-migrate --envPath .env -f .node-pg-migraterc.cjs up",
    "migrate:down": "node-pg-migrate --envPath .env -f .node-pg-migraterc.cjs down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
